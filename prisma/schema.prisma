generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                @id @default(uuid())
  email                     String                @unique
  password                  String
  role                      Role                  @default(STUDENT)
  name                      String
  attendancePasskeyRequired Boolean               @default(false)
  student                   Student?
  teacher                   Teacher?
  passkeys                  PasskeyCredential[]
  passkeyRecoveryCodes      PasskeyRecoveryCode[]
  webAuthnCeremonies        WebAuthnCeremony[]
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
}

model Student {
  id                 String                 @id @default(uuid())
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String                 @unique
  department         String?
  className          String?
  batch              String?
  registrationNumber String                 @unique
  enrollments        Enrollment[]
  attendanceRecords  AttendanceRecord[]
  presenceProofs     PresenceVerification[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model Teacher {
  id         String      @id @default(uuid())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String      @unique
  department String?
  classrooms Classroom[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Classroom {
  id                 String                @id @default(uuid())
  name               String
  subjectCode        String
  joinCode           String                @unique
  section            String?
  academicTerm       String
  teacher            Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId          String
  enrollments        Enrollment[]
  invitations        ClassroomInvitation[]
  attendanceSessions AttendanceSession[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([teacherId, subjectCode, academicTerm])
  @@index([teacherId])
}

model Enrollment {
  id          String    @id @default(uuid())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId String
  joinedAt    DateTime  @default(now())

  @@unique([studentId, classroomId])
  @@index([classroomId])
}

model ClassroomInvitation {
  id                 String           @id @default(uuid())
  classroom          Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId        String
  email              String
  name               String
  registrationNumber String?
  department         String?
  className          String?
  batch              String?
  token              String           @unique @default(uuid())
  status             InvitationStatus @default(PENDING)
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([classroomId, email])
  @@index([email, status])
}

model AttendanceSession {
  id                  String                  @id @default(uuid())
  classroom           Classroom               @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId         String
  method              AttendanceMethod
  status              AttendanceSessionStatus @default(ACTIVE)
  startedAt           DateTime                @default(now())
  endsAt              DateTime
  latitude            Float?
  longitude           Float?
  radiusMeters        Int?
  frequencyMinHz      Int?
  frequencyMaxHz      Int?
  frequencyIntervalMs Int?
  minFrequencyMatches Int?
  attendanceRecords   AttendanceRecord[]
  presenceProofs      PresenceVerification[]
  auditEvents         AttendanceAuditEvent[]
  report              AttendanceReport?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([classroomId, status])
  @@index([endsAt])
}

model AttendanceRecord {
  id             String            @id @default(uuid())
  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  status         AttendanceStatus  @default(PRESENT)
  method         AttendanceMethod
  confidence     Float?
  distanceMeters Float?
  deviceVerified Boolean           @default(false)
  proofHash      String?
  evidence       Json?
  verifiedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, verifiedAt])
}

model PasskeyCredential {
  id         String                 @id
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  publicKey  Bytes
  counter    BigInt                 @default(0)
  transports String[]
  deviceType String
  backedUp   Boolean                @default(false)
  lastUsedAt DateTime?
  proofs     PresenceVerification[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([userId])
}

model WebAuthnCeremony {
  id           String               @id @default(uuid())
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  type         WebAuthnCeremonyType
  challenge    String               @unique
  authorizedAt DateTime?
  expiresAt    DateTime
  createdAt    DateTime             @default(now())

  @@index([userId, type, expiresAt])
}

model PasskeyRecoveryCode {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model PresenceVerification {
  id                String                     @id @default(uuid())
  session           AttendanceSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId         String
  student           Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId         String
  method            AttendanceMethod
  status            PresenceVerificationStatus @default(PENDING_DEVICE)
  proofHash         String
  confidence        Float
  distanceMeters    Float?
  evidence          Json
  webAuthnChallenge String?
  credential        PasskeyCredential?         @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  credentialId      String?
  expiresAt         DateTime
  verifiedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, status, expiresAt])
}

model AttendanceAuditEvent {
  id           String                   @id @default(uuid())
  session      AttendanceSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId    String
  sequence     Int
  type         AttendanceAuditEventType
  actorId      String?
  payload      Json
  previousHash String
  eventHash    String                   @unique
  createdAt    DateTime                 @default(now())

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
}

model AttendanceReport {
  id          String            @id @default(uuid())
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String            @unique
  eventCount  Int
  recordCount Int
  headHash    String
  payloadHash String
  signature   String
  publicKey   String
  algorithm   String            @default("Ed25519")
  generatedAt DateTime          @default(now())
}

enum Role {
  STUDENT
  TEACHER
}

enum AttendanceMethod {
  GEOLOCATION
  ULTRASOUND
}

enum AttendanceSessionStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum WebAuthnCeremonyType {
  REGISTRATION
  MANAGEMENT
}

enum PresenceVerificationStatus {
  PENDING_DEVICE
  VERIFIED
  REJECTED
  EXPIRED
}

enum AttendanceAuditEventType {
  SESSION_STARTED
  CHALLENGE_COMMITTED
  PROOF_ACCEPTED
  DEVICE_VERIFIED
  ATTENDANCE_RECORDED
  SESSION_CLOSED
  REPORT_SIGNED
}
