generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  name      String
  student   Student?
  teacher   Teacher?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                 String             @id @default(uuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String             @unique
  department         String?
  className          String?
  batch              String?
  registrationNumber String             @unique
  enrollments        Enrollment[]
  attendanceRecords  AttendanceRecord[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Teacher {
  id         String      @id @default(uuid())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String      @unique
  department String?
  classrooms Classroom[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Classroom {
  id                 String              @id @default(uuid())
  name               String
  subjectCode        String
  joinCode           String              @unique
  section            String?
  academicTerm       String
  teacher            Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId          String
  enrollments        Enrollment[]
  invitations        ClassroomInvitation[]
  attendanceSessions AttendanceSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([teacherId, subjectCode, academicTerm])
  @@index([teacherId])
}

model Enrollment {
  id          String    @id @default(uuid())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId String
  joinedAt    DateTime  @default(now())

  @@unique([studentId, classroomId])
  @@index([classroomId])
}

model ClassroomInvitation {
  id                 String           @id @default(uuid())
  classroom          Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId        String
  email              String
  name               String
  registrationNumber String?
  department         String?
  className          String?
  batch              String?
  token              String           @unique @default(uuid())
  status             InvitationStatus @default(PENDING)
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([classroomId, email])
  @@index([email, status])
}

model AttendanceSession {
  id                  String                  @id @default(uuid())
  classroom           Classroom               @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId         String
  method              AttendanceMethod
  status              AttendanceSessionStatus @default(ACTIVE)
  startedAt           DateTime                @default(now())
  endsAt              DateTime
  latitude            Float?
  longitude           Float?
  radiusMeters        Int?
  frequencyMinHz      Int?
  frequencyMaxHz      Int?
  frequencyIntervalMs Int?
  minFrequencyMatches Int?
  attendanceRecords   AttendanceRecord[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([classroomId, status])
  @@index([endsAt])
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  status         AttendanceStatus  @default(PRESENT)
  method         AttendanceMethod
  confidence     Float?
  distanceMeters Float?
  evidence       Json?
  verifiedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, verifiedAt])
}

enum Role {
  STUDENT
  TEACHER
}

enum AttendanceMethod {
  GEOLOCATION
  ULTRASOUND
}

enum AttendanceSessionStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}
