FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server.mjs ./server.mjs
COPY src/lib/audit-core.js ./src/lib/audit-core.js
COPY src/lib/presence-core.js ./src/lib/presence-core.js
COPY src/lib/redis-protocol.js ./src/lib/redis-protocol.js

USER node
EXPOSE 8080

CMD ["node", "server.mjs", "--production", "--realtime-only"]
