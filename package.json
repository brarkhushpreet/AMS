{
  "name": "classpulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "find-my-way": "9.7.0",
    "minimatch": "10.2.6",
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "valibot": "1.4.2"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "prisma generate && next build",
    "start": "node server.mjs --production",
    "start:realtime": "node server.mjs --production --realtime-only",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "publish:cloudflare": "opennextjs-cloudflare deploy",
    "ci:cloudflare": "npm run db:generate && npm run lint && npm run typecheck && npm test && npm run test:demo && npm run db:deploy && npm run build:cloudflare",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/protocol.test.mjs tests/spectrum.test.mjs tests/companion-state.test.mjs",
    "test:demo": "tsx --test tests/demo-policy.test.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "benchmark": "node scripts/run-integration.mjs --benchmark",
    "report:verify": "node scripts/verify-attendance-report.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.3",
    "@simplewebauthn/types": "9.0.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "1.27.0",
    "motion": "12.42.2",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "papaparse": "5.5.4",
    "pg": "8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "redis": "6.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.6.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prisma": "7.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "wrangler": "^4.136.3"
  }
}
