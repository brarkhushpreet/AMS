DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classpulse
REDIS_URL=redis://localhost:6379

# Generate independent high-entropy values for each secret in production.
AUTH_SECRET=replace-with-at-least-32-random-bytes
PRESENCE_PROOF_SECRET=replace-with-a-different-random-secret
ATTENDANCE_SIGNING_SECRET=replace-with-a-different-random-secret

AUTH_TRUST_HOST=true
APP_HOST=0.0.0.0
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
REALTIME_PUBLIC_URL=ws://localhost:3000/ws/attendance

# Required by the standalone realtime process in production. Comma-separated,
# exact HTTPS origins; do not use a wildcard.
ALLOWED_ORIGINS=http://localhost:3000

# Set false on deployments where public portfolio demo access is not wanted.
DEMO_MODE=true

# Passkeys are origin-bound. Use the deployed hostname and HTTPS origin in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
